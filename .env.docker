# =================================================================
# RAMS — Docker Environment Template
#
# Usage:
#   1. Copy to .env:         cp .env.docker .env
#   2. Set DB_PASSWORD, MYSQL_ROOT_PASSWORD, and REDIS_PASSWORD below.
#      Docker Compose validates these required values before it runs any command.
#   3. Generate an APP_KEY:  docker compose run --rm app php artisan key:generate --show
#      Paste the output as the value of APP_KEY below, then set MAIL_* values.
#   4. Start: docker compose up -d
#
# Host aliases for Docker service names replace 127.0.0.1:
#   DB_HOST    = mysql   (container name)
#   REDIS_HOST = redis   (container name)
# =================================================================

APP_NAME=RAMS
APP_ENV=production
APP_KEY=                          # REQUIRED — see instructions above
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=UTC
APP_BIND_ADDRESS=127.0.0.1         # Keep HTTP behind a TLS-terminating reverse proxy
APP_PORT=80
# Trust the private Nginx-to-PHP-FPM hop so X-Forwarded-Proto from the TLS
# terminator is honored. Do not use this setting when PHP accepts public traffic.
TRUSTED_PROXIES=REMOTE_ADDR

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

HASH_DRIVER=argon2id
# Accept existing bcrypt hashes during the first Argon2id rollout; successful
# logins are rehashed atomically. Set this to true after legacy hashes retire.
HASH_VERIFY=false

# -----------------------------------------------------------------
# Logging
# -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------
# Database — service name "mysql" resolves inside Docker network
# -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rams
DB_USERNAME=rams
DB_PASSWORD=
DB_BIND_ADDRESS=127.0.0.1
DB_FORWARD_PORT=3306              # Optional loopback-only port for DB tools

# MySQL root password — used by the MySQL Docker container only
# (not used by Laravel itself)
MYSQL_ROOT_PASSWORD=

# -----------------------------------------------------------------
# Redis — service name "redis" resolves inside Docker network
# -----------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_FORWARD_PORT=6379           # Optional loopback-only port for Redis CLI
REDIS_MAXMEMORY=256mb
# Keep queue/session records from being silently evicted. Monitor capacity or
# split cache and queue Redis roles before changing this policy.
REDIS_MAXMEMORY_POLICY=noeviction

# -----------------------------------------------------------------
# Cache, Session, Queue — all Redis-backed
# -----------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=360

# -----------------------------------------------------------------
# Filesystem
# -----------------------------------------------------------------
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------
# Mail
# -----------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Leave CORS_ALLOWED_ORIGINS unset to allow only APP_URL, or set a comma-separated allowlist.
# CORS_ALLOWED_ORIGINS=https://your-domain.example

# Backups: configure an encrypted, off-host backup disk and a recipient before enabling the scheduler.
BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

# -----------------------------------------------------------------
# Sanctum
# -----------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=rams_

# -----------------------------------------------------------------
# Horizon
# -----------------------------------------------------------------
HORIZON_PREFIX=rams_horizon:

# -----------------------------------------------------------------
# Spatie Permission
# -----------------------------------------------------------------
PERMISSION_TEAM_ENABLE=true

# -----------------------------------------------------------------
# Vite
# -----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
