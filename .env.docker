# =================================================================
# RAMS — Docker Environment Template
#
# Usage:
#   1. Copy to .env:         cp .env.docker .env
#   2. Generate an APP_KEY:  docker compose run --rm app php artisan key:generate --show
#      Paste the output as the value of APP_KEY below.
#   3. Set DB_PASSWORD and MYSQL_ROOT_PASSWORD to secure values.
#   4. Start: docker compose up -d
#
# Host aliases for Docker service names replace 127.0.0.1:
#   DB_HOST    = mysql   (container name)
#   REDIS_HOST = redis   (container name)
# =================================================================

APP_NAME=RAMS
APP_ENV=production
APP_KEY=                          # REQUIRED — see instructions above
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_PORT=80                       # Host port mapped to nginx (change to e.g. 8080 if 80 is taken)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

HASH_DRIVER=argon2id

# -----------------------------------------------------------------
# Logging
# -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------
# Database — service name "mysql" resolves inside Docker network
# -----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rams
DB_USERNAME=rams
DB_PASSWORD=secret                # Change this in production
DB_FORWARD_PORT=3306              # Host port for DB tools (TablePlus, DBeaver)

# MySQL root password — used by the MySQL Docker container only
# (not used by Laravel itself)
MYSQL_ROOT_PASSWORD=rootsecret    # Change this in production

# -----------------------------------------------------------------
# Redis — service name "redis" resolves inside Docker network
# -----------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_FORWARD_PORT=6379           # Host port for Redis CLI / RedisInsight

# -----------------------------------------------------------------
# Cache, Session, Queue — all Redis-backed
# -----------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------
# Filesystem
# -----------------------------------------------------------------
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------
# Mail (use log driver for development, configure SMTP for production)
# -----------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@rams.test"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------
# Sanctum
# -----------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=rams_

# -----------------------------------------------------------------
# Horizon
# -----------------------------------------------------------------
HORIZON_PREFIX=rams_horizon:

# -----------------------------------------------------------------
# Spatie Permission
# -----------------------------------------------------------------
PERMISSION_TEAM_ENABLE=true

# -----------------------------------------------------------------
# Vite
# -----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"