APP_NAME=RAMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://rams.test
APP_TIMEZONE=UTC
# Comma-separated trusted proxy IPs/CIDRs. Leave empty when no reverse proxy is used.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

HASH_DRIVER=argon2id
HASH_VERIFY=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rams
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@rams.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=rams.test

# Spatie Permission
PERMISSION_TEAM_ENABLE=true

# Horizon
# Comma-separated email addresses allowed to access /horizon (in addition to the SYSTEM Super Admin)
HORIZON_ALLOWED_EMAILS=

# Required when running UserSeeder in production.
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=

# Sanctum token expiry (minutes). Default: 43200 = 30 days
SANCTUM_TOKEN_EXPIRATION=43200

# Auto-Deployment (GitHub Webhook — triggered automatically on push)
# Generate with: openssl rand -hex 32
# Add this to your PRODUCTION .env only — never commit the real value
DEPLOY_WEBHOOK_SECRET=

# Manual Pull Trigger (hit /pull.php?token=YOUR_TOKEN to pull + migrate)
# Generate with: openssl rand -hex 32  (use a DIFFERENT value from webhook secret)
DEPLOY_PULL_TOKEN=

# Optional: override auto-detected binary paths on the production server
# DEPLOY_PHP_BINARY=/usr/bin/php84
# DEPLOY_COMPOSER_BINARY=/usr/local/bin/composer
# DEPLOY_GIT_BINARY=/usr/bin/git
